---
import YoutubeEmbed from '../components/YoutubeEmbed.astro'
import PageLayout from '../layouts/PageLayout.astro'
import type { Metadata } from '../utils/seo'
import Image from 'astro/components/Image.astro'
import publicSpeakingImage from '../assets/images/submissions2.jpeg'

const meta: Metadata = {
  title: 'Public Speaking | Sara Rogers Acting',
  description:
    'Empower yourself or your team with professional public speaking training. Overcome anxiety, engage audiences, and improve communication skills in 4 weeks.',
  url: 'https://adultactingcoach.com/public-speaking',
}

const programFacts = [
  ['4 weeks', 'Weekly coaching sessions'],
  ['3 hours', 'Per session'],
  ['On-site', 'At your business or an alternate space'],
]

const practiceAreas = [
  'Overcoming public speaking anxiety',
  'Structuring presentations for maximum impact',
  'Using voice, body language, and presence with intention',
  'Engaging and persuading an audience',
  'Memorization techniques for scripted material',
  'Handling Q&A and impromptu speaking situations',
]

const audiences = [
  'Executives and team leaders',
  'Sales teams',
  'Customer-facing employees',
  'Nonprofit and fundraising teams',
  'Professionals preparing for presentations, pitches, or events',
]
---

<PageLayout meta={meta}>
  <div class="mx-auto max-w-6xl pb-4">
    <section
      class="grid items-center gap-10 pt-28 md:grid-cols-[1.05fr_0.95fr] md:gap-14 md:pt-36"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
        >
          For teams and professionals
        </p>
        <h1 class="mt-3 max-w-3xl text-gray-950">
          Speak with clarity.<br />Be remembered.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-gray-700 md:text-xl">
          Sara&apos;s public speaking training helps people turn nerves into
          presence—whether they&apos;re leading a meeting, presenting an idea,
          or speaking to a room for the first time.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex min-h-12 items-center justify-center rounded-md bg-purple px-6 py-3 text-lg font-semibold text-white shadow-sm transition hover:bg-purple-light"
        >
          Discuss training for your team
        </a>
      </div>

      <figure
        class="overflow-hidden rounded-xl bg-gray-200 shadow-lg shadow-purple/10"
      >
        <Image
          src={publicSpeakingImage}
          alt="Sara Rogers setting up a camera for hands-on coaching"
          width={600}
          height={400}
          class="aspect-[4/3] w-full object-cover object-center"
          loading="eager"
        />
        <figcaption class="bg-white px-5 py-4 text-sm leading-6 text-gray-600">
          Hands-on coaching shaped by Sara&apos;s on-camera and performance
          experience.
        </figcaption>
      </figure>
    </section>

    <dl class="mt-14 grid border-y border-purple/20 md:grid-cols-3">
      {
        programFacts.map(([value, label], index) => (
          <div
            class:list={[
              'px-0 py-6 md:px-8',
              index > 0 &&
                'border-t border-purple/15 md:border-l md:border-t-0',
            ]}
          >
            <dt class="text-sm font-semibold uppercase tracking-wide text-purple">
              {label}
            </dt>
            <dd class="mt-2 text-3xl font-bold text-gray-950">{value}</dd>
          </div>
        ))
      }
    </dl>

    <section class="mt-16 grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
        >
          An actor&apos;s eye
        </p>
        <h2 class="mt-3 text-gray-950">More than words on a page.</h2>
        <p class="mt-5 text-lg leading-8 text-gray-700 md:text-xl">
          Sara brings decades of acting, coaching, and performance experience to
          business communication. The work is practical, supportive, and built
          around how people actually show up in a room.
        </p>
      </div>

      <ol class="border-t border-gray-300">
        {
          practiceAreas.map((area, index) => (
            <li class="grid grid-cols-[2.5rem_1fr] gap-4 border-b border-gray-300 py-4 md:grid-cols-[3.5rem_1fr]">
              <span class="pt-0.5 text-sm font-semibold text-purple">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="text-xl font-semibold leading-7 text-gray-900">
                {area}
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-16 border-t border-gray-300 pt-10">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
          >
            Built around your room
          </p>
          <h2 class="mt-3 text-gray-950">For people who need to be heard.</h2>
        </div>

        <div>
          <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2" role="list">
            {
              audiences.map((audience) => (
                <li class="border-b border-gray-200 pb-3 text-lg leading-7 text-gray-700">
                  {audience}
                </li>
              ))
            }
          </ul>
          <p class="mt-7 text-lg leading-8 text-gray-700">
            Sara adapts the training to your industry, audience, and pressure
            points. Organizations including Make-A-Wish Foundation have used
            this approach to help people communicate with more confidence in
            donor conversations, events, and internal meetings.
          </p>
        </div>
      </div>
    </section>

    <section class="mt-16 bg-purple px-6 py-10 text-white md:px-10 md:py-12">
      <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-white/75"
          >
            Hear it from a student
          </p>
          <h2 class="mt-3 text-white">Confidence you can see.</h2>
          <p class="mt-4 text-lg leading-8 text-white/85">
            Watch a firsthand account of working with Sara.
          </p>
        </div>
        <div class="overflow-hidden bg-black shadow-lg">
          <YoutubeEmbed id="0fKFOy3rNnQ" />
        </div>
      </div>
    </section>

    <section
      class="flex flex-col items-start border-b border-gray-300 py-16 md:items-center md:text-center"
    >
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-purple">
        Let&apos;s talk
      </p>
      <h2 class="mt-3 max-w-3xl text-gray-950">
        Bring public speaking training to your team.
      </h2>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-gray-700 md:text-xl">
        Contact Sara to discuss goals, scheduling, location, and pricing.
        Private one-on-one public speaking coaching is also available on
        request.
      </p>
      <a
        href="/contact"
        class="mt-8 inline-flex min-h-12 items-center justify-center rounded-md bg-purple px-6 py-3 text-lg font-semibold text-white shadow-sm transition hover:bg-purple-light"
      >
        Contact Sara
      </a>
    </section>
  </div>
</PageLayout>
