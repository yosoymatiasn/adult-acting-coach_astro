---
import PageLayout from '../layouts/PageLayout.astro'
import { brandingTestimonials } from '../data/testimonials'
import Carousel from '../components/Carousel.astro'
import YoutubeEmbed from '../components/YoutubeEmbed.astro'
import type { Metadata } from '../utils/seo'

const meta: Metadata = {
  title: 'Building Your Brand | Sara Rogers Acting',
  description:
    'An 8-week private coaching course with Sara Rogers for actors, performers, and models who want to clarify goals, sharpen materials, and build their professional brand.',
  url: 'https://adultactingcoach.com/building-your-brand',
}

const programFacts = [
  ['8 weeks', 'Private, one-on-one coaching'],
  ['$1,200', 'For the full course'],
  ['Up to 2', 'Sessions per week'],
]

const curriculum = [
  {
    number: '01',
    title: 'Find your direction',
    items: [
      'Discovering your main type',
      'Understanding your unique attributes',
      'Setting clear, achievable goals',
    ],
  },
  {
    number: '02',
    title: 'Shape the materials',
    items: [
      'Writing an impressive resume',
      'Headshot guidance',
      'Showcasing your skills with confidence',
    ],
  },
  {
    number: '03',
    title: 'Practice for the work',
    items: [
      'On-camera skills',
      'Self-taping scenes and monologues',
      'Memorization techniques',
    ],
  },
  {
    number: '04',
    title: 'Navigate the industry',
    items: [
      'Social media and industry websites',
      'Agents, casting directors, and etiquette',
      'Union and non-union choices',
    ],
  },
]
---

<PageLayout meta={meta}>
  <div class="mx-auto max-w-6xl pb-4">
    <section
      class="grid gap-10 pt-28 md:grid-cols-[1.2fr_0.8fr] md:items-end md:gap-14 md:pt-36"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
        >
          Private coaching for performers
        </p>
        <h1 class="mt-3 max-w-4xl text-gray-950">
          Build a career plan that feels like you.
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-gray-700 md:text-xl">
          Building Your Brand is an 8-week one-on-one coaching course for
          actors, performers, and models who want to sharpen their materials,
          clarify their direction, and move through the industry with more
          confidence.
        </p>
      </div>

      <div class="border-l-4 border-purple pl-6 md:pb-2">
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
        >
          A personal investment
        </p>
        <p class="mt-2 text-5xl font-bold leading-none text-gray-950">$1,200</p>
        <p class="mt-3 text-lg leading-7 text-gray-700">
          For the full 8-week course, scheduled around your availability.
        </p>
      </div>
    </section>

    <dl class="mt-14 grid border-y border-purple/20 md:grid-cols-3">
      {
        programFacts.map(([value, label], index) => (
          <div
            class:list={[
              'px-0 py-6 md:px-8',
              index > 0 &&
                'border-t border-purple/15 md:border-l md:border-t-0',
            ]}
          >
            <dt class="text-sm font-semibold uppercase tracking-wide text-purple">
              {label}
            </dt>
            <dd class="mt-2 text-3xl font-bold text-gray-950">{value}</dd>
          </div>
        ))
      }
    </dl>

    <section class="mt-16 grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
        >
          Not a one-size-fits-all package
        </p>
        <h2 class="mt-3 text-gray-950">A plan built around your next move.</h2>
      </div>
      <div class="space-y-5 text-lg leading-8 text-gray-700 md:text-xl">
        <p>
          This is for performers who want more than a brush-up on skills.
          Whether you are just starting or already working, Sara helps you make
          a clear action plan around the work that matters most to you.
        </p>
        <p>
          You&apos;ll work one-on-one, so every session can respond to your
          goals, questions, material, and momentum.
        </p>
      </div>
    </section>

    <section class="mt-16 border-t border-gray-300 pt-10">
      <div class="max-w-3xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
        >
          The work
        </p>
        <h2 class="mt-3 text-gray-950">
          Four connected parts of your professional toolkit.
        </h2>
      </div>

      <div class="mt-8 grid border-t border-gray-300 md:grid-cols-2">
        {
          curriculum.map((section, index) => (
            <section
              class:list={[
                'py-7',
                index % 2 === 0
                  ? 'md:pr-10'
                  : 'md:border-l md:border-gray-300 md:pl-10',
                index > 1 && 'border-t border-gray-300',
              ]}
            >
              <p class="text-sm font-semibold text-purple">{section.number}</p>
              <h3 class="mt-2 text-2xl text-gray-950">{section.title}</h3>
              <ul class="mt-4 space-y-2" role="list">
                {section.items.map((item) => (
                  <li class="flex gap-3 text-lg leading-7 text-gray-700">
                    <span
                      class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-purple"
                      aria-hidden="true"
                    />
                    {item}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    <section
      class="mt-16 border-y border-purple/20 bg-purple/5 px-0 py-10 md:px-8"
    >
      <div class="grid gap-8 md:grid-cols-[0.85fr_1.15fr] md:items-center">
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
          >
            A useful starting point
          </p>
          <h2 class="mt-3 text-gray-950">Take Step One first and save $100.</h2>
        </div>
        <p class="text-lg leading-8 text-gray-700 md:text-xl">
          Complete the Step One Saturday Workshop before starting Building Your
          Brand and receive $100 off. The workshop becomes your first week, so
          the private course is then seven weeks long.
        </p>
      </div>
    </section>

    <section
      class="mt-16 grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-center"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
        >
          Words from students
        </p>
        <h2 class="mt-3 text-gray-950">
          See what one-on-one coaching can unlock.
        </h2>
        <p class="mt-5 text-lg leading-8 text-gray-700 md:text-xl">
          Students share their experience working with Sara on their goals and
          professional direction.
        </p>
      </div>
      <Carousel class="w-full" label="Student video testimonials">
        {
          brandingTestimonials.map(({ youtubeId }) => (
            <YoutubeEmbed lazy id={youtubeId} />
          ))
        }
      </Carousel>
    </section>

    <section
      class="flex flex-col items-start border-b border-gray-300 py-16 md:items-center md:text-center"
    >
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-purple">
        Ready when you are
      </p>
      <h2 class="mt-3 max-w-3xl text-gray-950">
        Start a conversation about your next chapter.
      </h2>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-gray-700 md:text-xl">
        Contact Sara to discuss your goals, availability, and whether Building
        Your Brand is the right next step for you.
      </p>
      <a
        href="/contact"
        class="mt-8 inline-flex min-h-12 items-center justify-center rounded-md bg-purple px-6 py-3 text-lg font-semibold text-white shadow-sm transition hover:bg-purple-light"
      >
        Contact Sara
      </a>
    </section>
  </div>
</PageLayout>
