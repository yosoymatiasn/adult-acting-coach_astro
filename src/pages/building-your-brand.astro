---
import PageLayout from '../layouts/PageLayout.astro'
import { brandingTestimonials } from '../data/testimonials'
import Carousel from '../components/Carousel.astro'
import YoutubeEmbed from '../components/YoutubeEmbed.astro'
import type { Metadata } from '../utils/seo'

const meta: Metadata = {
  title: 'Building Your Brand | Sara Rogers Acting',
  description:
    'An 8-week private coaching course with Sara Rogers for actors, performers, and models who want to clarify goals, sharpen materials, and build their professional brand.',
  url: 'https://adultactingcoach.com/building-your-brand',
}

const curriculum = [
  {
    number: '01',
    title: 'Your direction',
    items: [
      'Discovering your main type',
      'Understanding your unique attributes',
    ],
  },
  {
    number: '02',
    title: 'Your materials',
    items: [
      'Writing an impressive resume',
      'Showcasing your skills',
      'Headshot guidance',
    ],
  },
  {
    number: '03',
    title: 'Practice',
    items: [
      'On-camera skills',
      'Self-taping scenes and monologues',
      'Memorization techniques',
    ],
  },
  {
    number: '04',
    title: 'The industry',
    items: [
      'Social media strategy',
      'Agents and casting directors',
      'Set and agent etiquette',
      'Union vs. non-union choices',
      'Industry websites',
    ],
  },
]
---

<PageLayout meta={meta}>
  <div class="mx-auto max-w-6xl pb-4">
    <section class="max-w-4xl pt-28 md:pt-36">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-purple">
        Private Coaching
      </p>
      <h1 class="mt-3 text-gray-950">Building Your Brand</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-gray-700 md:text-xl">
        An 8-week private coaching course for actors, performers, and models who
        want to clarify their goals, sharpen their materials, and present
        themselves with confidence.
      </p>
    </section>

    <section class="mt-16 grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
        >
          A one-on-one plan
        </p>
        <h2 class="mt-3 text-gray-950">Who it is for</h2>
      </div>
      <div class="space-y-5 text-lg leading-8 text-gray-700 md:text-xl">
        <p>
          Starting on a date you and Sara choose, this 8-week personalized
          course focuses on the business side of acting and modeling, your
          goals, and the materials you need to present yourself well.
        </p>
        <p>
          This course is for performers who want more than a brush-up on skills.
          Whether you are just starting or already working, the goal is to build
          a clear action plan tailored to you.
        </p>
      </div>
    </section>

    <section class="mt-16 border-t border-gray-300 pt-10">
      <div class="max-w-3xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
        >
          What you&apos;ll work on
        </p>
      </div>

      <div class="mt-8 grid border-t border-gray-300 md:grid-cols-2">
        {
          curriculum.map((section, index) => (
            <section
              class:list={[
                'py-7',
                index % 2 === 0
                  ? 'md:pr-10'
                  : 'md:border-l md:border-gray-300 md:pl-10',
                index > 1 && 'border-t border-gray-300',
              ]}
            >
              <p class="text-sm font-semibold text-purple">{section.number}</p>
              <h3 class="mt-2 text-2xl text-gray-950">{section.title}</h3>
              <ul class="mt-4 space-y-2" role="list">
                {section.items.map((item) => (
                  <li class="flex gap-3 text-lg leading-7 text-gray-700">
                    <span
                      class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-purple"
                      aria-hidden="true"
                    />
                    {item}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    <section
      class="mt-16 grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-center"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
        >
          Words from students
        </p>
        <h2 class="mt-3 text-gray-950">
          Students share their experience with Sara&apos;s one-on-one coaching.
        </h2>
      </div>
      <Carousel class="w-full" label="Student video testimonials">
        {
          brandingTestimonials.map(({ youtubeId }) => (
            <YoutubeEmbed lazy id={youtubeId} />
          ))
        }
      </Carousel>
    </section>

    <section
      class="mt-16 border-y border-purple/20 bg-purple/5 px-0 py-10 md:px-8"
    >
      <div class="grid gap-8 md:grid-cols-[0.85fr_1.15fr] md:items-center">
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
          >
            Discount opportunity
          </p>
          <h2 class="mt-3 text-gray-950">
            Participate in the Step One Saturday Workshop and get $100 off.
          </h2>
        </div>
        <p class="text-lg leading-8 text-gray-700 md:text-xl">
          This reduces the course to 7 weeks, with your first week covered in
          the 3-hour workshop.
        </p>
      </div>
    </section>

    <section class="mt-16 border-t border-gray-300 pt-10">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
          >
            Fees and scheduling
          </p>
          <h2 class="mt-3 text-gray-950">The practical details.</h2>
        </div>
        <div class="space-y-5 text-lg leading-8 text-gray-700 md:text-xl">
          <p>Investment: $1200 for the full 8-week course, payable upfront.</p>
          <p>
            Scheduling is flexible based on Sara&apos;s availability and yours,
            up to two sessions per week. Missed sessions must be rescheduled
            within the 8-week period.
          </p>
        </div>
      </div>
    </section>

    <section
      class="flex flex-col items-start border-b border-gray-300 py-16 md:items-center md:text-center"
    >
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-purple">
        Ready to schedule?
      </p>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-gray-700 md:text-xl">
        Payment methods include Zelle, cash, check, and PayPal. To schedule your
        private session or ask for more information, contact Sara.
      </p>
      <a
        href="/contact"
        class="mt-8 inline-flex min-h-12 items-center justify-center rounded-md bg-purple px-6 py-3 text-lg font-semibold text-white shadow-sm transition hover:bg-purple-light"
      >
        Contact Sara
      </a>
    </section>
  </div>
</PageLayout>
