---
import RegistrationForm from '../../components/RegistrationForm.astro'
import SessionsAside from '../../components/SessionsAside.astro'
import { classes } from '../../data/classes/classes'
import { sessions as classSessions } from '../../data/classes/sessions'
import PageLayout from '../../layouts/PageLayout.astro'
import Image from 'astro/components/Image.astro'
import { createMetaDescription, type Metadata } from '../../utils/seo'

export async function getStaticPaths() {
  return classes.map((classData) => ({
    params: {
      slug: classData.slug,
    },

    props: {
      classData,
      sessions: classSessions.filter(
        (session) => session.classSlug === classData.slug
      ),
    },
  }))
}

const { classData } = Astro.props

const meta: Metadata = {
  title: `${classData.title} | Sara Rogers Acting`,
  description: createMetaDescription(classData.description),
  url: `https://adultactingcoach.com/classes/${classData.slug}`,
  image: classData.imageUrl,
  imageAlt: classData.title,
}
---

<PageLayout meta={meta}>
  <RegistrationForm />
  <div class="max-w-6xl mx-auto px-6 pb-12 pt-28 md:pt-36">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-12 lg:items-start">
      <section class="lg:col-start-1">
        <p class="text-sm font-semibold uppercase tracking-widest text-purple">
          {classData.type}
        </p>
        <h1 class="mt-2">{classData.title}</h1>

        <p class="mt-8 text-xl leading-9 text-gray-700">
          {classData.description}
        </p>
      </section>

      <aside
        class="order-2 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:sticky lg:top-24"
      >
        <Image
          src={classData.imageUrl}
          alt={classData.title}
          width={900}
          height={600}
          loading="eager"
          class="w-full rounded-lg object-cover shadow-lg"
        />

        <SessionsAside classData={classData} />
      </aside>

      <section class="order-3 lg:col-start-1">
        <dl class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
            <dt
              class="text-xs font-semibold uppercase tracking-wide text-purple"
            >
              Best for
            </dt>
            <dd class="mt-2 text-sm leading-6 text-gray-700">
              {classData.details.bestFor}
            </dd>
          </div>

          <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
            <dt
              class="text-xs font-semibold uppercase tracking-wide text-purple"
            >
              Format
            </dt>
            <dd class="mt-2 text-sm leading-6 text-gray-700">
              {classData.details.format}
            </dd>
          </div>
        </dl>

        <section class="mt-12 border-t border-gray-200 pt-10">
          <p
            class="text-sm font-semibold uppercase tracking-widest text-purple"
          >
            Class focus
          </p>
          <h2 class="mt-2">What you’ll work on</h2>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2" role="list">
            {
              classData.details.focus.map((item) => (
                <li class="flex gap-3 rounded-lg bg-purple/5 px-4 py-3 text-gray-800">
                  <span
                    class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-purple"
                    aria-hidden="true"
                  />
                  <span class="leading-6">{item}</span>
                </li>
              ))
            }
          </ul>
        </section>

        {
          classData.details.bring && (
            <section class="mt-8 rounded-lg border border-purple/20 bg-purple/5 p-6">
              <h2 class="text-xl">What to bring</h2>
              <p class="mt-2 leading-7 text-gray-700">
                {classData.details.bring}
              </p>
            </section>
          )
        }
      </section>
    </div>
  </div>
</PageLayout>
