---
export const prerender = false

import PageLayout from '../../layouts/PageLayout.astro'
import ClassList from '../../components/ClassList.astro'
import type { Metadata } from '../../utils/seo'
import RegistrationForm from '../../components/RegistrationForm.astro'
import PageIntro from '../../components/PageIntro.astro'

const meta: Metadata = {
  title: 'Classes | Sara Rogers Acting',
  description:
    "Explore a world of possibilities with Sara's adult acting classes. From improvisation to monologues and scenes, our year-round classes offer a transformative journey into the art of acting.",
  url: 'https://adultactingcoach.com/classes',
}
---

<PageLayout meta={meta}>
  <RegistrationForm />
  <PageIntro
    title="Classes"
    description="Explore upcoming classes and workshops with Sara. Choose the session that fits your goals, then register directly from the listing."
  />
  <div
    class="mt-12 grid items-start gap-y-4 md:auto-rows-fr md:grid-cols-2 md:gap-x-4 md:gap-y-3 lg:gap-x-6 lg:gap-y-6"
  >
    <ClassList />
  </div>
</PageLayout>
