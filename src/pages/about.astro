---
import Image from 'astro/components/Image.astro'
import YoutubeEmbed from '../components/YoutubeEmbed.astro'
import PageLayout from '../layouts/PageLayout.astro'
import Sara from '../assets/images/sara.png'
import type { Metadata } from '../utils/seo'

const externalLinks = [
  {
    url: 'https://voyagemia.com/interview/check-out-sara-rogerss-story/',
    title: "Sara Rogers' Story",
    description: 'Enjoy this article on Sara from Voyage Miami',
  },
]

const meta: Metadata = {
  title: 'About | Sara Rogers Acting',
  description:
    'Learn about award-winning South Florida acting coach Sara Rogers, whose four-decade career spans acting, casting, public speaking, voice-over, and professional performer training.',
  url: 'https://adultactingcoach.com/about',
}
---

<PageLayout meta={meta}>
  <section class="max-w-4xl mx-auto flex flex-col">
    <section
      class="grid gap-8 pt-28 md:grid-cols-[0.8fr_1.2fr] md:items-center md:pt-36"
    >
      <Image
        src={Sara}
        alt="Sara Rogers"
        class="mx-auto aspect-square w-full max-w-72 rounded-full border-4 border-purple object-cover shadow-lg shadow-purple/20"
        width="320"
        height="320"
      />
      <div class="text-center md:text-left">
        <h1>Sara Rogers</h1>
        <p class="mt-4 text-gray-700">
          Nationally recognized, award-winning acting coach, casting
          professional, writer, speaker, performer, and longtime creative force
          in South Florida&apos;s film, television, and theatre community.
        </p>
      </div>
    </section>

    <section class="mt-12 grid gap-4 md:grid-cols-3">
      <div class="rounded-lg border border-purple/15 bg-purple/5 p-5">
        <p class="text-3xl font-semibold text-purple">40+</p>
        <p
          class="mt-2 text-sm font-semibold uppercase tracking-wide text-gray-600"
        >
          Years of experience
        </p>
      </div>

      <div class="rounded-lg border border-purple/15 bg-purple/5 p-5">
        <p class="text-3xl font-semibold text-purple">Acting</p>
        <p
          class="mt-2 text-sm font-semibold uppercase tracking-wide text-gray-600"
        >
          Scene study, monologues, on-camera work, improv
        </p>
      </div>

      <div class="rounded-lg border border-purple/15 bg-purple/5 p-5">
        <p class="text-3xl font-semibold text-purple">Award-Winning</p>
        <p
          class="mt-2 text-sm font-semibold uppercase tracking-wide text-gray-600"
        >
          Lifetime Achievement & Community Favorite
        </p>
      </div>
    </section>

    <article class="order-2 mt-12 space-y-10 font-light">
      <section>
        <h2>Teaching & coaching</h2>

        <div class="mt-4 space-y-5">
          <p>
            Nationally recognized, award-winning Acting Coach Sara Rogers has
            been a respected leader in the South Florida film, television,
            theatre, and public speaking community for more than four decades.
            As an acting coach, casting professional, writer, speaker, and
            talent coordinator, she has dedicated her career to helping
            performers discover their authentic voice while preparing them for
            the realities of the entertainment industry.
          </p>

          <p>
            With a deep commitment to nurturing talent, Sara has served as a
            guest instructor at the ACT Symposium and The Lesbian Thespian. Her
            work as a Public Speaking Coach for the Make-A-Wish Foundation and
            Guest Coach for Women in Distress reflects her passion for helping
            people from all walks of life communicate with confidence and
            authenticity.
          </p>

          <p>
            Her teaching philosophy emphasizes authentic performance, practical
            industry knowledge, and a supportive environment where students feel
            safe to take creative risks, build confidence, and grow at every
            level.
          </p>
        </div>
      </section>

      <section>
        <h2>Classes & programs</h2>

        <div class="mt-4 space-y-5">
          <p>
            Throughout her career, Sara has developed innovative educational
            programs that bridge the gap between aspiring performers and the
            professional entertainment industry. Her signature course,
            &quot;Step One – The Business End of the Acting & Modeling
            Industry,&quot; has guided countless newcomers through the
            often-confusing business side of acting.
          </p>

          <p>
            Her camera programs, including &quot;How to Audition for
            Camera,&quot; provide practical, hands-on instruction in
            professional on-camera techniques, audition preparation, and
            performance skills.
          </p>

          <p>
            As an instructor at Hollywood Playhouse for more than five years,
            Sara created and taught monologue, scene study, improvisation, and
            camera classes for students ranging from beginners to seasoned
            professionals. She also spent more than six years teaching at The
            Acting School of South Florida while presenting guest lectures on
            acting, improvisation, and public speaking for arts organizations
            and the corporate community.
          </p>
        </div>
      </section>

      <section>
        <h2>Casting, performance & voice work</h2>

        <div class="mt-4 space-y-5">
          <p>
            Sara&apos;s casting experience includes working alongside acclaimed
            New York Casting Director Louis DiGiamo, as well as respected South
            Florida casting professionals Dee Miller, Kim Houston, Ellen Jacoby,
            Lori Wyman, and Unique Casting.
          </p>

          <p>
            Her performance credits include commercials for Bacardi Rum, Crest,
            Publix, Nextel, and Hertz, along with television appearances in <em
              >Miami Vice</em
            >, <em>21 Jump Street</em>, and
            <em>Extra Large</em>.
          </p>

          <p>
            As a voice-over artist, Sara has worked with Broadcast Video, The
            Miami Herald, NBC Channel 4, The Puppet Theatre, and the New York
            production of <em>Leaf Meets</em>. She has also contributed as a
            writer for Broadcast Video, <em>Stage and Screen Newspaper</em>, and <em
              >Marquee Magazine</em
            >, sharing her industry knowledge with actors and entertainment
            professionals throughout the region.
          </p>
        </div>
      </section>

      <section>
        <h2>At ArtServe</h2>

        <div class="mt-4 space-y-5">
          <p>
            For nearly a decade, Sara has been a cornerstone instructor at
            ArtServe, where she teaches weekly in-person acting, improvisation,
            camera, and public speaking classes.
          </p>

          <p>
            Her classes combine professional training with an encouraging,
            dynamic environment designed to help performers develop their craft,
            strengthen their confidence, and take meaningful creative risks.
          </p>
        </div>
      </section>

      <section>
        <h2>A lasting commitment to performers</h2>

        <div class="mt-4 space-y-5">
          <p>
            Known for her enthusiasm, honesty, and ability to inspire performers
            of all ages and experience levels, Sara continues to shape the next
            generation of actors through classes, workshops, speaking
            engagements, and one-on-one coaching.
          </p>

          <p>
            Whether working with a first-time performer or an established
            professional, her mission remains the same: to provide exceptional
            training in a safe, encouraging, and dynamic environment while
            helping every student discover their unique potential.
          </p>

          <p>
            Today, Sara Rogers continues to be one of South Florida&apos;s most
            respected acting coaches, leaving a lasting legacy through her
            students, her teaching, and her lifelong dedication to the
            performing arts.
          </p>
        </div>
      </section>
    </article>

    <section
      class="order-1 mt-12 rounded-xl border border-purple/15 bg-white p-6 shadow-lg shadow-purple/10 md:p-8"
    >
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-purple">
          Awards & Recognition
        </p>

        <h2 class="mt-2">Recognized for a lifetime of artistic impact</h2>
      </div>

      <div class="mx-auto mt-8 max-w-3xl space-y-5">
        <div
          class="grid gap-4 rounded-xl border border-gray-200 bg-gray-50 p-6 md:grid-cols-[220px_1fr] md:gap-8"
        >
          <div>
            <p
              class="text-xs font-semibold uppercase tracking-wide text-gray-500"
            >
              2026
            </p>

            <h3 class="mt-2 text-xl font-semibold text-gray-900">
              ArtServe Impact Award
            </h3>

            <p class="mt-2 font-medium text-purple">Lifetime Achievement</p>
          </div>

          <div>
            <p class="leading-relaxed text-gray-700">
              Sara Rogers received the Broward County Arts & Cultural Division /
              ArtServe Impact Award for Lifetime Achievement in recognition of
              her decades of outstanding contributions to the performing arts
              and her commitment to educating and mentoring actors throughout
              South Florida.
            </p>

            <a
              href="https://www.youtube.com/watch?v=ZgpN94O9yQY&t=47s"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 inline-flex items-center gap-2 rounded-lg bg-purple px-5 py-3 font-semibold text-white shadow-md shadow-purple/20 transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-purple/25"
            >
              <span>Watch Sara receive the award</span>
              <span aria-hidden="true">▶</span>
            </a>
          </div>
        </div>

        <div
          class="grid gap-4 rounded-xl border border-gray-200 bg-gray-50 p-6 md:grid-cols-[220px_1fr] md:gap-8"
        >
          <div>
            <p
              class="text-xs font-semibold uppercase tracking-wide text-gray-500"
            >
              2026
            </p>

            <h3 class="mt-2 text-xl font-semibold text-gray-900">
              Sun Sentinel Community Favorite
            </h3>

            <p class="mt-2 font-medium text-purple">Acting Coach</p>
          </div>

          <p class="leading-relaxed text-gray-700">
            Sara was voted the Sun Sentinel Community Favorite Acting Coach, a
            distinction awarded by the South Florida community she has proudly
            served for many years.
          </p>
        </div>
      </div>
    </section>

    <section
      class="order-3 mt-14 rounded-lg border border-gray-200 bg-white p-8 shadow-lg shadow-purple/10"
    >
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-purple">
          Media & Press
        </p>

        <h2 class="mt-2">Interviews & features</h2>

        <p class="mx-auto mt-3 max-w-2xl text-sm text-gray-600">
          Hear Sara discuss her coaching journey and work with actors in South
          Florida.
        </p>
      </div>

      <div
        class="mt-8 overflow-hidden rounded-lg border border-gray-200 bg-gray-50"
      >
        <div class="border-b border-gray-200 bg-white px-5 py-4">
          <p
            class="text-xs font-semibold uppercase tracking-wide text-gray-500"
          >
            Featured Interview
          </p>

          <h3 class="mt-1 text-xl font-semibold text-gray-900">
            Spotlight of the Arts
          </h3>
        </div>

        <div class="p-4">
          <YoutubeEmbed id="gdB8MKam9Kg" />
        </div>
      </div>

      <div class="mt-8">
        <h3 class="text-lg font-semibold text-gray-900">Featured Articles</h3>

        <div class="mt-4 grid gap-4">
          {
            externalLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="block rounded-lg border border-gray-200 bg-gray-50 p-5 transition hover:border-purple hover:bg-purple/5"
              >
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">
                  Article
                </p>

                <h4 class="mt-1 text-lg font-semibold text-gray-900">
                  {link.title}
                </h4>

                <p class="mt-2 text-sm text-gray-600">{link.description}</p>

                <p class="mt-3 text-sm font-semibold text-purple">
                  Read article →
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </section>
</PageLayout>
