---
import PageLayout from '../layouts/PageLayout.astro'
import type { Metadata } from '../utils/seo'
import Image from 'astro/components/Image.astro'
import ServiceFacts from '../components/ServiceFacts.astro'

const meta: Metadata = {
  title: 'Self-Tapes | Sara Rogers Acting',
  description:
    'Book a self-tape session with Sara Rogers for audition support, a reader, coaching, playback review, and file submission help.',
  url: 'https://adultactingcoach.com/self-tapes',
}

const selfTapeImage =
  'https://secure.meetupstatic.com/photos/event/4/7/a/9/event_474678345.webp?w=640'

const sessionFacts = [
  ['$75', 'For the first hour'],
  ['Reader + coach', 'In the room with you'],
  ['Playback + files', 'Review, select, and send'],
]

const sessionSteps = [
  {
    title: 'Stress-free setup',
    description:
      'A calm session so you can focus on the audition instead of the technology.',
  },
  {
    title: 'Playback review',
    description:
      'Watch your takes with Sara and choose the audition that best serves the work.',
  },
  {
    title: 'File help',
    description:
      'Files are labeled and sent electronically so your submission is ready to go.',
  },
]
---

<PageLayout meta={meta}>
  <div class="mx-auto max-w-6xl pb-4">
    <section
      class="grid items-center gap-10 pt-28 md:grid-cols-[1.05fr_0.95fr] md:gap-14 md:pt-36"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
        >
          Audition support
        </p>
        <h1 class="mt-3 max-w-3xl text-gray-950">
          Self-Taping and Submissions
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-gray-700 md:text-xl">
          Book a stress-free self-tape session with Sara as your reader and
          coach, so you can send in a confident, polished audition.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex min-h-12 items-center justify-center rounded-md bg-purple px-6 py-3 text-lg font-semibold text-white shadow-sm transition hover:bg-purple-light"
        >
          Schedule a self-tape
        </a>
      </div>

      <figure
        class="overflow-hidden rounded-xl bg-gray-200 shadow-lg shadow-purple/10"
      >
        <Image
          src={selfTapeImage}
          alt="Actor preparing for a self-tape session"
          width={640}
          height={480}
          widths={[320, 480, 640]}
          sizes="(max-width: 767px) 100vw, 50vw"
          class="aspect-[4/3] w-full object-cover object-left-top"
          loading="eager"
        />
        <figcaption class="bg-white px-5 py-4 text-sm leading-6 text-gray-600">
          A reader, coach, and playback partner in one session.
        </figcaption>
      </figure>
    </section>

    <ServiceFacts facts={sessionFacts} />

    <section class="mt-16 grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
        >
          Self-taping and submissions
        </p>
        <h2 class="mt-3 text-gray-950">The norm, not the exception.</h2>
        <p class="mt-5 text-lg leading-8 text-gray-700 md:text-xl">
          Actors are now asked to act, direct themselves, make strong choices,
          and submit clean files quickly.
        </p>
        <p class="mt-5 text-lg leading-8 text-gray-700 md:text-xl">
          With Sara, you get a built-in reader and coach. You tape, watch
          playbacks, choose the right take, label the files, and send them
          electronically.
        </p>
      </div>

      <ol class="border-t border-gray-300">
        {
          sessionSteps.map((step, index) => (
            <li class="grid grid-cols-[2.5rem_1fr] gap-4 border-b border-gray-300 py-5 md:grid-cols-[3.5rem_1fr]">
              <span class="pt-0.5 text-sm font-semibold text-purple">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="mb-1 text-xl text-gray-900">{step.title}</h3>
                <p class="text-lg leading-8 text-gray-700 md:text-xl">
                  {step.description}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-16 border-t border-gray-300 pt-10">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
          >
            Rates and timing
          </p>
          <h2 class="mt-3 text-gray-950">Simple, flexible scheduling.</h2>
        </div>
        <div class="space-y-5 text-lg leading-8 text-gray-700 md:text-xl">
          <p>
            The rate is a flat $75 for the hour. If you have several pages or
            more than one scene, additional time is $37.50 for every 30 minutes.
            One and a half hours is $112.50, and two hours is $150.
          </p>
          <p>
            Payment options include cash, PayPal, credit cards, or checks. Cash
            is preferred and you&apos;ll receive a receipt.
          </p>
        </div>
      </div>
    </section>

    <section
      class="mt-16 border-y border-purple/20 bg-purple/5 px-0 py-10 md:px-8"
    >
      <div class="grid gap-8 md:grid-cols-[0.85fr_1.15fr] md:items-start">
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
          >
            Before you arrive
          </p>
          <h2 class="mt-3 text-gray-950">
            Give yourself room to do good work.
          </h2>
        </div>
        <div class="space-y-5 text-lg leading-8 text-gray-700 md:text-xl">
          <p>
            Your time begins at the time reserved, so please allow enough time
            for traffic, rehearsal, makeup, and wardrobe changes. If you are
            memorized and ready to tape, the session usually goes smoothly
            within the hour. If you finish early, you can use the time to pick
            Sara&apos;s brain.
          </p>
          <p>
            The background is grey. Please avoid logos or anything that draws
            the eye away from your audition. Solid colors are best. No black,
            white, or red. Wear jackets, sweaters, or clothing that supports the
            character when possible. Bring options and let the camera decide.
          </p>
          <p class="text-lg leading-8 text-gray-700 md:text-xl">
            Sara is seasoned and wants you to book the job. Read more from her
            testimonials to get a sense of her coaching style and how she works
            with actors.
          </p>
        </div>
      </div>
    </section>

    <section class="border-b border-gray-300 py-16">
      <a
        href="/contact"
        class="inline-flex min-h-12 items-center justify-center rounded-md bg-purple px-6 py-3 text-lg font-semibold text-white shadow-sm transition hover:bg-purple-light"
      >
        Schedule a Self-Tape
      </a>
    </section>
  </div>
</PageLayout>
