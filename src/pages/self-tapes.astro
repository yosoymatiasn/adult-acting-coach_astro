---
import PageLayout from '../layouts/PageLayout.astro'
import type { Metadata } from '../utils/seo'
import Image from 'astro/components/Image.astro'

const meta: Metadata = {
  title: 'Self-Tapes | Sara Rogers Acting',
  description:
    'Book a self-tape session with Sara Rogers for audition support, a reader, coaching, playback review, and file submission help.',
  url: 'https://adultactingcoach.com/self-tapes',
}

const selfTapeImage =
  'https://secure.meetupstatic.com/photos/event/4/7/a/9/event_474678345.webp?w=640'

const sessionFacts = [
  ['$75', 'For the first hour'],
  ['Reader + coach', 'In the room with you'],
  ['Playback + files', 'Review, select, and send'],
]

const sessionSteps = [
  'Settle in with a reader and coach who understands the audition process.',
  'Tape your scene, then watch playback together and choose the take that serves the work.',
  'Label the files and send a clean, professional submission with confidence.',
]
---

<PageLayout meta={meta}>
  <div class="mx-auto max-w-6xl pb-4">
    <section
      class="grid items-center gap-10 pt-28 md:grid-cols-[1.05fr_0.95fr] md:gap-14 md:pt-36"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
        >
          Audition support
        </p>
        <h1 class="mt-3 max-w-3xl text-gray-950">Let the work come through.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-gray-700 md:text-xl">
          Book a calm, focused self-tape session with Sara as your reader and
          coach—so you can make strong choices, review the work, and send in a
          polished audition.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex min-h-12 items-center justify-center rounded-md bg-purple px-6 py-3 text-lg font-semibold text-white shadow-sm transition hover:bg-purple-light"
        >
          Schedule a self-tape
        </a>
      </div>

      <figure
        class="overflow-hidden rounded-xl bg-gray-200 shadow-lg shadow-purple/10"
      >
        <Image
          src={selfTapeImage}
          alt="Actor preparing for a self-tape session"
          width={640}
          height={480}
          widths={[320, 480, 640]}
          sizes="(max-width: 767px) 100vw, 50vw"
          class="aspect-[4/3] w-full object-cover object-left-top"
          loading="eager"
        />
        <figcaption class="bg-white px-5 py-4 text-sm leading-6 text-gray-600">
          A reader, coach, and playback partner in one session.
        </figcaption>
      </figure>
    </section>

    <dl class="mt-14 grid border-y border-purple/20 md:grid-cols-3">
      {
        sessionFacts.map(([value, label], index) => (
          <div
            class:list={[
              'px-0 py-6 md:px-8',
              index > 0 &&
                'border-t border-purple/15 md:border-l md:border-t-0',
            ]}
          >
            <dt class="text-sm font-semibold uppercase tracking-wide text-purple">
              {label}
            </dt>
            <dd class="mt-2 text-3xl font-bold text-gray-950">{value}</dd>
          </div>
        ))
      }
    </dl>

    <section class="mt-16 grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
        >
          One focused session
        </p>
        <h2 class="mt-3 text-gray-950">More than pressing record.</h2>
        <p class="mt-5 text-lg leading-8 text-gray-700 md:text-xl">
          Self-taping asks you to act, direct yourself, make choices, and move
          quickly. Sara gives you a reliable partner for every part of that
          process.
        </p>
      </div>

      <ol class="border-t border-gray-300">
        {
          sessionSteps.map((step, index) => (
            <li class="grid grid-cols-[2.5rem_1fr] gap-4 border-b border-gray-300 py-5 md:grid-cols-[3.5rem_1fr]">
              <span class="pt-0.5 text-sm font-semibold text-purple">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="text-lg leading-8 text-gray-700 md:text-xl">
                {step}
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-16 border-t border-gray-300 pt-10">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
          >
            Rates and timing
          </p>
          <h2 class="mt-3 text-gray-950">Simple, flexible scheduling.</h2>
        </div>
        <div class="space-y-5 text-lg leading-8 text-gray-700 md:text-xl">
          <p>
            The rate is $75 for the first hour. If you have several pages or
            more than one scene, additional time is $37.50 for every 30 minutes.
            One and a half hours is $112.50; two hours is $150.
          </p>
          <p>
            Payment options include cash, PayPal, credit cards, or checks. Cash
            is preferred and you&apos;ll receive a receipt.
          </p>
        </div>
      </div>
    </section>

    <section
      class="mt-16 border-y border-purple/20 bg-purple/5 px-0 py-10 md:px-8"
    >
      <div class="grid gap-8 md:grid-cols-[0.85fr_1.15fr] md:items-start">
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-purple"
          >
            Before you arrive
          </p>
          <h2 class="mt-3 text-gray-950">
            Give yourself room to do good work.
          </h2>
        </div>
        <div class="space-y-5 text-lg leading-8 text-gray-700 md:text-xl">
          <p>
            Your session begins at the time reserved, so allow time for traffic,
            rehearsal, makeup, and wardrobe. If you arrive memorized and ready,
            you can use more of the hour for choices and playback.
          </p>
          <p>
            The background is grey. Avoid logos or anything distracting; solid
            colors work best, but skip black, white, and red. Bring clothing
            options that support the character, and let the camera decide.
          </p>
        </div>
      </div>
    </section>

    <section
      class="flex flex-col items-start border-b border-gray-300 py-16 md:items-center md:text-center"
    >
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-purple">
        Ready to tape
      </p>
      <h2 class="mt-3 max-w-3xl text-gray-950">
        Bring in the material. Leave with a finished submission.
      </h2>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-gray-700 md:text-xl">
        Contact Sara to schedule a self-tape session or ask about the time your
        material may need.
      </p>
      <a
        href="/contact"
        class="mt-8 inline-flex min-h-12 items-center justify-center rounded-md bg-purple px-6 py-3 text-lg font-semibold text-white shadow-sm transition hover:bg-purple-light"
      >
        Schedule a self-tape
      </a>
    </section>
  </div>
</PageLayout>
