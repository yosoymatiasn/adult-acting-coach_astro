---
// ResponsiveHeader.astro
import { navLinks, type NavLink } from '../data/nav'
import Image from 'astro/components/Image.astro'
import logo from '../assets/images/logo.png'

const currentPath = Astro.url.pathname
---

<header
  id="site-header"
  class="fixed top-0 z-50 w-full bg-transparent py-4 transition-[padding] duration-300"
>
  <div
    class="container relative z-50 mx-auto flex items-center justify-between px-4"
  >
    <a
      href="/"
      class="flex h-12 w-12 items-center justify-center rounded-full bg-white p-2 ring-1 ring-purple/15 lg:hidden"
    >
      <Image
        src={logo}
        alt="Logo"
        width="56"
        height="56"
        class="h-full w-full object-contain"
        loading="eager"
      />
    </a>

    <!-- Desktop Nav -->
    <nav
      id="desktop-nav"
      class="mx-auto hidden items-center gap-4 rounded-full border border-purple/10 bg-white/95 px-5 py-3 text-purple shadow-lg shadow-purple/10 backdrop-blur-md transition-[padding,box-shadow,background-color] duration-300 lg:flex"
    >
      <!-- Logo -->
      <a
        href="/"
        id="desktop-logo-link"
        class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-white p-2 ring-1 ring-purple/15 transition-[width,height,padding,opacity] duration-300 hover:opacity-80 lg:h-16 lg:w-16 lg:p-2.5"
      >
        <Image
          src={logo}
          alt="Logo"
          width="80"
          height="80"
          class="h-full w-full object-contain"
          loading="eager"
        />
      </a>
      <ul class="flex flex-wrap items-center gap-2 lg:gap-3">
        {
          navLinks.map((link: NavLink) => (
            <li>
              <a
                href={link.href}
                aria-current={currentPath === link.href ? 'page' : undefined}
                class:list={[
                  'rounded px-2 py-1 text-base font-semibold transition-colors hover:bg-purple/10 lg:px-3 lg:text-lg',
                  currentPath === link.href && 'bg-purple/10 text-purple',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Hamburger Button -->
    <button
      id="hamburger"
      class="relative z-50 ml-auto flex h-11 w-11 cursor-pointer flex-col items-center justify-center gap-1.5 rounded-md border border-purple/20 bg-white text-purple shadow-sm lg:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span id="bar1" class="h-0.5 w-6 rounded-sm bg-purple transition-all"
      ></span>
      <span id="bar2" class="h-0.5 w-6 rounded-sm bg-purple transition-all"
      ></span>
      <span id="bar3" class="h-0.5 w-6 rounded-sm bg-purple transition-all"
      ></span>
    </button>
  </div>

  <div
    id="mobile-menu-backdrop"
    class="pointer-events-none fixed inset-0 z-40 bg-gray-950/35 opacity-0 backdrop-blur-[1px] transition-opacity duration-200 ease-out motion-reduce:transition-none lg:hidden"
    aria-hidden="true"
  >
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="pointer-events-none absolute left-0 top-full z-50 w-full origin-top -translate-y-4 scale-95 transform-gpu px-4 pt-1 text-purple opacity-0 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] will-change-transform motion-reduce:transition-none lg:hidden"
    aria-hidden="true"
    inert
  >
    <div
      id="mobile-menu-panel"
      class="pointer-events-none mx-auto max-w-md overflow-hidden rounded-b-2xl border border-purple/10 bg-white shadow-2xl shadow-purple/20"
    >
      <div class="flex items-center gap-3 border-b border-purple/10 px-5 py-4">
        <span
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white p-2 ring-1 ring-purple/15"
        >
          <Image
            src={logo}
            alt="Sara Rogers logo"
            width="64"
            height="64"
            class="h-full w-full object-contain"
            loading="eager"
          />
        </span>
        <div>
          <p class="text-lg font-bold leading-tight text-purple">Sara Rogers</p>
          <p class="text-sm leading-tight text-gray-600">
            Acting classes and coaching
          </p>
        </div>
      </div>

      <div class="space-y-3 px-5 py-5">
        <a
          href="/classes"
          class="block rounded-md bg-purple px-4 py-3 text-center text-lg font-semibold text-white transition-colors hover:bg-purple-light"
        >
          View Classes
        </a>

        <a
          href="/contact"
          class="block rounded-md border border-purple/25 px-4 py-3 text-center text-lg font-semibold text-purple transition-colors hover:bg-purple/10"
        >
          Contact Sara
        </a>

        <div class="grid grid-cols-2 gap-2 pt-2">
          {
            navLinks
              .filter(
                (link: NavLink) =>
                  !['/', '/classes', '/contact'].includes(link.href)
              )
              .map((link: NavLink) => (
                <a
                  href={link.href}
                  class="rounded-md bg-purple/5 px-3 py-3 text-center text-base font-semibold transition-colors hover:bg-purple/10"
                >
                  {link.label}
                </a>
              ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Toggle Script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const hamburger = document.getElementById('hamburger')
      const menu = document.getElementById('mobile-menu')
      const menuPanel = document.getElementById('mobile-menu-panel')
      const menuBackdrop = document.getElementById('mobile-menu-backdrop')
      const header = document.getElementById('site-header')
      const desktopNav = document.getElementById('desktop-nav')
      const desktopLogoLink = document.getElementById('desktop-logo-link')

      const bar1 = document.getElementById('bar1')
      const bar2 = document.getElementById('bar2')
      const bar3 = document.getElementById('bar3')

      let isOpen = false
      let isScrolled = false

      const setMenuOpen = (nextOpen: boolean) => {
        isOpen = nextOpen
        menu?.classList.add('pointer-events-none')
        menu?.classList.remove('pointer-events-auto')
        menuPanel?.classList.toggle('pointer-events-none', !isOpen)
        menuPanel?.classList.toggle('pointer-events-auto', isOpen)
        menu?.classList.toggle('opacity-0', !isOpen)
        menu?.classList.toggle('opacity-100', isOpen)
        menu?.classList.toggle('-translate-y-4', !isOpen)
        menu?.classList.toggle('translate-y-0', isOpen)
        menu?.classList.toggle('scale-95', !isOpen)
        menu?.classList.toggle('scale-100', isOpen)
        menu?.setAttribute('aria-hidden', String(!isOpen))
        menu?.toggleAttribute('inert', !isOpen)
        menuBackdrop?.classList.toggle('pointer-events-none', !isOpen)
        menuBackdrop?.classList.toggle('pointer-events-auto', isOpen)
        menuBackdrop?.classList.toggle('opacity-0', !isOpen)
        menuBackdrop?.classList.toggle('opacity-100', isOpen)
        menuBackdrop?.setAttribute('aria-hidden', String(!isOpen))
        hamburger?.setAttribute('aria-expanded', String(isOpen))

        bar1?.classList.toggle('rotate-45', isOpen)
        bar1?.classList.toggle('translate-y-2', isOpen)

        bar2?.classList.toggle('opacity-0', isOpen)

        bar3?.classList.toggle('-rotate-45', isOpen)
        bar3?.classList.toggle('-translate-y-2', isOpen)
      }

      const setScrolled = (nextScrolled: boolean) => {
        if (isScrolled === nextScrolled) return
        isScrolled = nextScrolled

        header?.classList.toggle('py-2', isScrolled)
        header?.classList.toggle('py-4', !isScrolled)

        desktopNav?.classList.toggle('bg-white/90', isScrolled)
        desktopNav?.classList.toggle('bg-white/95', !isScrolled)
        desktopNav?.classList.toggle('px-4', isScrolled)
        desktopNav?.classList.toggle('py-2', isScrolled)
        desktopNav?.classList.toggle('px-5', !isScrolled)
        desktopNav?.classList.toggle('py-3', !isScrolled)
        desktopNav?.classList.toggle('shadow-xl', isScrolled)
        desktopNav?.classList.toggle('shadow-lg', !isScrolled)

        desktopLogoLink?.classList.toggle('lg:h-12', isScrolled)
        desktopLogoLink?.classList.toggle('lg:w-12', isScrolled)
        desktopLogoLink?.classList.toggle('lg:p-1.5', isScrolled)
        desktopLogoLink?.classList.toggle('h-14', !isScrolled)
        desktopLogoLink?.classList.toggle('w-14', !isScrolled)
        desktopLogoLink?.classList.toggle('p-2', !isScrolled)
        desktopLogoLink?.classList.toggle('lg:h-16', !isScrolled)
        desktopLogoLink?.classList.toggle('lg:w-16', !isScrolled)
        desktopLogoLink?.classList.toggle('lg:p-2.5', !isScrolled)
      }

      const handleScroll = () => {
        setScrolled(window.scrollY > 24)
      }

      handleScroll()
      window.addEventListener('scroll', handleScroll, { passive: true })

      // Toggle menu and animate hamburger
      hamburger?.addEventListener('click', () => {
        setMenuOpen(!isOpen)
      })

      menuBackdrop?.addEventListener('click', () => {
        setMenuOpen(false)
      })

      header?.addEventListener('click', (event) => {
        const target = event.target as Node

        if (
          isOpen &&
          !hamburger?.contains(target) &&
          !menuPanel?.contains(target)
        ) {
          setMenuOpen(false)
        }
      })

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && isOpen) {
          setMenuOpen(false)
          hamburger?.focus()
        }
      })

      menu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          setMenuOpen(false)
        })
      })

      // Reset on desktop resize
      const mediaQuery = window.matchMedia('(min-width: 1024px)')
      mediaQuery.addEventListener('change', (e) => {
        if (e.matches) {
          setMenuOpen(false)
        }
      })
    })
  </script>
</header>
