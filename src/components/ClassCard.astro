---
import type { TClassListing } from '../data/classes'
import Image from 'astro/components/Image.astro'
import {
  formatDate,
  formatLongWeekday,
  formatTimeRange,
} from '../helpers/listingHelpers'

const { classData } = Astro.props as { classData: TClassListing }

const { date } = formatDate(classData.date)
const weekday = formatLongWeekday(classData.date)
const timeRange = formatTimeRange(classData.date, classData.endDate)
---

<div
  data-class-card
  data-class-title={classData.title}
  data-class-slug={classData.slug}
  data-class-date={classData.date}
  data-class-end-date={classData.endDate}
  data-class-url={classData.url}
  data-class-day-of-week={classData.dayOfWeek}
  data-class-type={classData.type}
  data-class-price={classData.price}
  data-class-early-price={classData.earlyPrice}
  data-class-door-price={classData.doorPrice}
  data-class-early-bird-days={classData.earlyBirdDays}
  class="w-full overflow-hidden rounded-lg border border-purple/10 bg-white shadow-sm shadow-purple/10 transition-shadow md:h-full md:hover:shadow-md"
>
  <a
    href={`/classes/${classData.slug}`}
    rel="noopener noreferrer"
    class="class-link relative"
  >
    <div
      class="group relative aspect-[2/1] overflow-hidden md:h-60 md:aspect-auto"
    >
      <div
        class="pointer-events-none absolute inset-0 z-10 bg-black/10 transition-colors md:bg-black/30 md:group-hover:bg-black/0"
      >
      </div>
      <Image
        data-class-image
        src={classData.imageUrl}
        alt={classData.title}
        width={800}
        height={400}
        class="h-full w-full scale-100 object-cover object-top transition-transform md:scale-105 md:group-hover:scale-100"
      />
    </div>
  </a>

  <div class="flex h-full flex-col p-4 md:px-6 md:py-4">
    <a href={`/classes/${classData.slug}`} class="class-link">
      <h2 class="text-3xl inline-block mb-1">{classData.title}</h2>
    </a>
    <div class="mt-2 text-sm font-medium text-gray-600 space-y-1">
      {
        classData.type === 'class' ? (
          <>
            <p>
              <span class="font-semibold text-gray-800">{weekday}s</span>
              <span class="mx-2 text-gray-400">•</span>
              <span class="font-semibold text-gray-800">{timeRange}</span>
            </p>
          </>
        ) : (
          <p>
            <span class="font-semibold text-gray-800">{weekday}</span>
            <span class="mx-2 text-gray-400">•</span>
            <span class="font-semibold text-gray-800">{timeRange}</span>
          </p>
        )
      }
      {
        classData.type === 'class' ? (
          <p>Starts {date.replace(/^[A-Za-z]{3},\s/, '')} </p>
        ) : (
          <p>{date.replace(/^[A-Za-z]{3},\s/, '')}</p>
        )
      }
    </div>
    <p class="mt-3 text-base line-clamp-3 text-gray-700">
      {classData.description}
    </p>

    <div
      class="mt-5 flex flex-wrap items-center gap-2 border-t border-gray-200 pt-4"
    >
      <div class="mr-auto">
        <p class="text-2xl font-semibold text-gray-900">${classData.price}</p>
      </div>
      <button
        type="button"
        data-register-button
        data-class-early-price={classData.earlyPrice}
        data-class-door-price={classData.doorPrice}
        data-class-early-bird-days={classData.earlyBirdDays}
        class="inline-block cursor-pointer rounded-md bg-purple px-12 py-3 text-center font-semibold text-white shadow-md transition-colors duration-200 hover:bg-purple-light"
      >
        Register
      </button>

      <a
        href={`/classes/${classData.slug}`}
        rel="noopener noreferrer"
        class="inline-block text-sm border border-purple text-purple hover:underline rounded-md py-2 px-6 text-center transition-all duration-200"
      >
        More details
      </a>
    </div>
  </div>
</div>

<script>
  const cards = document.querySelectorAll('[data-class-card]')

  cards.forEach((card) => {
    const image = card.querySelector('[data-class-image]')
    const links = card.querySelectorAll('.class-link')
    const registerButton = card.querySelector('[data-register-button]')

    links.forEach((link) => {
      link.addEventListener('mouseenter', () => {
        image?.classList.add('scale-100')
        image?.classList.remove('scale-110')
      })
      link.addEventListener('mouseleave', () => {
        image?.classList.add('scale-110')
        image?.classList.remove('scale-100')
      })
    })

    registerButton?.addEventListener('click', () => {
      window.dispatchEvent(
        new CustomEvent('open-class-modal', {
          detail: {
            title: card.getAttribute('data-class-title'),
            slug: card.getAttribute('data-class-slug'),
            type: card.getAttribute('data-class-type'),
            dayOfWeek: card.getAttribute('data-class-day-of-week'),
            date: card.getAttribute('data-class-date'),
            endDate: card.getAttribute('data-class-end-date'),
            url: card.getAttribute('data-class-url'),
            price: Number(card.getAttribute('data-class-price')),
            earlyPrice:
              Number(card.getAttribute('data-class-early-price')) || undefined,
            doorPrice:
              Number(card.getAttribute('data-class-door-price')) || undefined,
            earlyBirdDays:
              Number(card.getAttribute('data-class-early-bird-days')) ||
              undefined,
          },
        })
      )
    })
  })
</script>
