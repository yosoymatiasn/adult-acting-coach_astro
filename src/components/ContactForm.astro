<!-- Contact Form -->
<form
  data-netlify="true"
  name="contact"
  method="POST"
  netlify-honeypot="bot-field"
  class="w-full max-w-2xl rounded-xl bg-white p-6 shadow-xl sm:p-7"
  id="contact-form"
>
  <input type="hidden" name="form-name" value="contact" />
  <input type="hidden" name="summary" id="contact-summary" />

  <p class="hidden">
    <label>
      Don’t fill this out if you’re human:
      <input name="bot-field" type="text" />
    </label>
  </p>

  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-purple">
        Contact Sara
      </p>
      <h2 class="mt-1 text-2xl font-semibold text-gray-900">
        Start a conversation
      </h2>
    </div>
    <span class="mt-1 hidden h-2.5 w-2.5 rounded-full bg-purple sm:block"
    ></span>
  </div>

  <p class="mt-3 text-sm leading-6 text-gray-600">
    Tell Sara a little about what you&apos;d like to work on.
  </p>

  <div class="mt-6 grid gap-4 sm:grid-cols-3">
    <div>
      <label for="fullName" class="text-sm font-semibold text-gray-800">
        Full name
      </label>
      <input
        required
        id="fullName"
        type="text"
        name="fullName"
        autocomplete="name"
        class="mt-2 w-full rounded-md border border-gray-300 bg-gray-50 px-3 py-2.5 text-gray-900 transition-colors placeholder:text-gray-400 focus:border-purple focus:bg-white focus:outline-none focus:ring-2 focus:ring-purple/20"
      />
    </div>

    <div>
      <label for="email" class="text-sm font-semibold text-gray-800">
        Email
      </label>
      <input
        required
        id="email"
        type="email"
        name="email"
        autocomplete="email"
        class="mt-2 w-full rounded-md border border-gray-300 bg-gray-50 px-3 py-2.5 text-gray-900 transition-colors placeholder:text-gray-400 focus:border-purple focus:bg-white focus:outline-none focus:ring-2 focus:ring-purple/20"
      />
    </div>

    <div>
      <label for="phone" class="text-sm font-semibold text-gray-800">
        Phone <span class="font-normal text-gray-500">(optional)</span>
      </label>
      <input
        id="phone"
        type="tel"
        name="phone"
        autocomplete="tel"
        class="mt-2 w-full rounded-md border border-gray-300 bg-gray-50 px-3 py-2.5 text-gray-900 transition-colors placeholder:text-gray-400 focus:border-purple focus:bg-white focus:outline-none focus:ring-2 focus:ring-purple/20"
      />
    </div>

    <div class="sm:col-span-3">
      <label for="message" class="text-sm font-semibold text-gray-800">
        Message
      </label>
      <textarea
        required
        id="message"
        name="message"
        rows="4"
        class="mt-2 w-full resize-y rounded-md border border-gray-300 bg-gray-50 px-3 py-2.5 text-gray-900 transition-colors placeholder:text-gray-400 focus:border-purple focus:bg-white focus:outline-none focus:ring-2 focus:ring-purple/20"
      ></textarea>
    </div>
  </div>

  <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-end">
    <button
      type="submit"
      class="inline-flex cursor-pointer items-center justify-center rounded-md bg-purple px-5 py-3 font-semibold text-white transition-colors duration-200 hover:bg-purple-light focus:outline-none focus:ring-2 focus:ring-purple focus:ring-offset-2"
    >
      Send message
    </button>
  </div>
</form>

<!-- Success Message -->
<div
  id="success-message"
  role="status"
  aria-live="polite"
  tabindex="-1"
  class="hidden mt-8 max-w-2xl w-full rounded-lg bg-gradient-to-r from-green-100 to-green-50 px-6 py-4 text-green-800 shadow-lg text-center"
>
  <p class="text-base font-semibold tracking-wide">
    ✅ Thanks for reaching out! We'll get back to you soon.
  </p>
</div>

<div
  id="contact-error"
  role="alert"
  class="hidden mt-8 max-w-2xl w-full rounded-lg bg-red-50 px-6 py-4 text-red-800 shadow-lg text-center"
>
  <p class="text-base font-semibold tracking-wide">
    We couldn&apos;t send your message. Please try again or contact Sara
    directly.
  </p>
</div>

<!-- Form Submission Script -->
<script>
  const handleSubmit = (e: SubmitEvent) => {
    e.preventDefault()
    const form = e.target as HTMLFormElement
    const successMessage = document.getElementById('success-message')
    const errorMessage = document.getElementById('contact-error')

    const formData = new FormData(form)
    const data = new URLSearchParams()
    const summaryInput = document.getElementById(
      'contact-summary'
    ) as HTMLInputElement
    const fullName = String(formData.get('fullName')).trim()

    summaryInput.value = `New message from ${fullName}.`
    errorMessage?.classList.add('hidden')

    data.append('form-name', 'contact')
    for (const [key, value] of new FormData(form).entries()) {
      if (typeof value === 'string') {
        data.append(key, value)
      }
    }

    fetch('/', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
      },
      body: data.toString(),
    })
      .then((response) => {
        if (!response.ok) {
          throw new Error(`Contact submission failed (${response.status})`)
        }
        form.style.display = 'none'
        successMessage!.classList.remove('hidden')
        successMessage!.classList.add('opacity-0')
        setTimeout(() => {
          successMessage!.classList.remove('opacity-0')
          successMessage!.classList.add(
            'opacity-100',
            'transition-opacity',
            'duration-500'
          )
        }, 10)
        successMessage?.focus()
        console.log('Form successfully submitted')
      })
      .catch((error) => {
        errorMessage?.classList.remove('hidden')
        console.error(error)
      })
  }

  document
    .getElementById('contact-form')
    ?.addEventListener('submit', handleSubmit)
</script>
