<!-- Contact Form -->
<form
  data-netlify="true"
  name="contact"
  method="POST"
  netlify-honeypot="bot-field"
  class="flex w-full max-w-2xl flex-col rounded-lg bg-white px-5 py-6 shadow-xl sm:px-8 sm:py-8"
  id="contact-form"
>
  <input type="hidden" name="form-name" value="contact" />
  <input type="hidden" name="summary" id="contact-summary" />

  <p class="hidden">
    <label>
      Don’t fill this out if you’re human:
      <input name="bot-field" type="text" />
    </label>
  </p>

  <h2 class="text-center text-2xl font-semibold text-gray-700">
    Send a message
  </h2>

  <label for="fullName" class="text-gray-500 font-light mt-8">
    Full name
  </label>
  <input
    required
    id="fullName"
    type="text"
    name="fullName"
    autocomplete="name"
    class="bg-transparent border-b py-2 pl-4 focus:outline-none focus:rounded-md focus:ring-1 ring-purple font-light text-gray-500"
  />

  <label for="email" class="text-gray-500 font-light mt-4"> E-mail </label>
  <input
    required
    id="email"
    type="email"
    name="email"
    autocomplete="email"
    class="bg-transparent border-b py-2 pl-4 focus:outline-none focus:rounded-md focus:ring-1 ring-purple font-light text-gray-500"
  />

  <label for="phone" class="text-gray-500 font-light mt-4">
    Phone (Optional)
  </label>
  <input
    id="phone"
    type="tel"
    name="phone"
    autocomplete="tel"
    class="bg-transparent border-b py-2 pl-4 focus:outline-none focus:rounded-md focus:ring-1 ring-purple font-light text-gray-500"
  />

  <label for="message" class="text-gray-500 font-light mt-4"> Message </label>
  <textarea
    required
    id="message"
    name="message"
    rows="5"
    class="bg-transparent border-b py-2 pl-4 focus:outline-none focus:rounded-md focus:ring-1 ring-purple font-light text-gray-500"
  ></textarea>

  <div class="mt-5 flex flex-row items-center justify-start">
    <button
      type="submit"
      class="sr-link w-full max-w-none py-3 text-xl sm:w-auto sm:text-2xl"
    >
      Send
    </button>
  </div>
</form>

<!-- Success Message -->
<div
  id="success-message"
  role="status"
  aria-live="polite"
  tabindex="-1"
  class="hidden mt-8 max-w-2xl w-full rounded-lg bg-gradient-to-r from-green-100 to-green-50 px-6 py-4 text-green-800 shadow-lg text-center"
>
  <p class="text-base font-semibold tracking-wide">
    ✅ Thanks for reaching out! We'll get back to you soon.
  </p>
</div>

<div
  id="contact-error"
  role="alert"
  class="hidden mt-8 max-w-2xl w-full rounded-lg bg-red-50 px-6 py-4 text-red-800 shadow-lg text-center"
>
  <p class="text-base font-semibold tracking-wide">
    We couldn&apos;t send your message. Please try again or contact Sara
    directly.
  </p>
</div>

<!-- Form Submission Script -->
<script>
  const handleSubmit = (e: SubmitEvent) => {
    e.preventDefault()
    const form = e.target as HTMLFormElement
    const successMessage = document.getElementById('success-message')
    const errorMessage = document.getElementById('contact-error')

    const formData = new FormData(form)
    const data = new URLSearchParams()
    const summaryInput = document.getElementById(
      'contact-summary'
    ) as HTMLInputElement
    const fullName = String(formData.get('fullName')).trim()

    summaryInput.value = `New message from ${fullName}.`
    errorMessage?.classList.add('hidden')

    data.append('form-name', 'contact')
    for (const [key, value] of new FormData(form).entries()) {
      if (typeof value === 'string') {
        data.append(key, value)
      }
    }

    fetch('/', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
      },
      body: data.toString(),
    })
      .then((response) => {
        if (!response.ok) {
          throw new Error(`Contact submission failed (${response.status})`)
        }
        form.style.display = 'none'
        successMessage!.classList.remove('hidden')
        successMessage!.classList.add('opacity-0')
        setTimeout(() => {
          successMessage!.classList.remove('opacity-0')
          successMessage!.classList.add(
            'opacity-100',
            'transition-opacity',
            'duration-500'
          )
        }, 10)
        successMessage?.focus()
        console.log('Form successfully submitted')
      })
      .catch((error) => {
        errorMessage?.classList.remove('hidden')
        console.error(error)
      })
  }

  document
    .getElementById('contact-form')
    ?.addEventListener('submit', handleSubmit)
</script>
